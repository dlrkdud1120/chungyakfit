# 이 파일을 복사해 .env.local 로 이름을 바꾸고 값을 채우세요.
# .env.local 은 GitHub에 올라가지 않습니다 (.gitignore에 포함).

# 공공데이터포털 > 마이페이지 > 활용신청 현황 > 한국부동산원_청약홈 분양정보 조회 서비스
# "일반 인증키(Decoding)" 값을 따옴표 없이 붙여 넣으세요.
APPLYHOME_API_KEY=

# 카카오 개발자 > 내 애플리케이션 > 앱 키
# REST API 키: 주소→좌표 검색용. 서버에서만 씁니다 (브라우저에 보이지 않음).
KAKAO_REST_KEY=
# JavaScript 키: 지도 그리기용. 브라우저에서 쓰는 키라 화면 코드에 포함되며,
# 카카오 쪽에 등록한 도메인(localhost, Vercel 주소)에서만 작동합니다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# ── 카카오 로그인 (선택 기능. 비워 두면 로그인 버튼만 "설정 전"으로 나오고 나머지는 그대로 동작) ──
# AUTH_SECRET: 로그인 쿠키를 암호화하는 임의의 긴 글자. 터미널에서  npx auth secret  또는
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"  로 만들어 붙여 넣으세요.
AUTH_SECRET=
# AUTH_KAKAO_ID: 카카오 REST API 키 (비워 두면 위의 KAKAO_REST_KEY를 씁니다)
AUTH_KAKAO_ID=
# AUTH_KAKAO_SECRET: 카카오 개발자 > REST API 키 설정의 "클라이언트 시크릿" 코드
AUTH_KAKAO_SECRET=

# ── Supabase (마이페이지 저장소) ──
# Supabase 프로젝트 화면 위쪽 Connect 버튼(또는 Settings > Data API)에 나오는 Project URL  예: https://abcd1234.supabase.co
SUPABASE_URL=
# Settings > API Keys 의 Secret key (sb_secret_ 로 시작). 서버에서만 쓰는 키라 절대 NEXT_PUBLIC_ 을 붙이지 마세요.
SUPABASE_SECRET_KEY=
