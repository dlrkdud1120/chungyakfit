# 이 파일을 복사해 .env.local 로 이름을 바꾸고 값을 채우세요.
# .env.local 은 GitHub에 올라가지 않습니다 (.gitignore에 포함).

# 공공데이터포털 > 마이페이지 > 활용신청 현황 > 한국부동산원_청약홈 분양정보 조회 서비스
# "일반 인증키(Decoding)" 값을 따옴표 없이 붙여 넣으세요.
APPLYHOME_API_KEY=

# 카카오 개발자 > 내 애플리케이션 > 앱 키
# REST API 키: 주소→좌표 검색용. 서버에서만 씁니다 (브라우저에 보이지 않음).
KAKAO_REST_KEY=
# JavaScript 키: 지도 그리기용. 브라우저에서 쓰는 키라 화면 코드에 포함되며,
# 카카오 쪽에 등록한 도메인(localhost, Vercel 주소)에서만 작동합니다.
NEXT_PUBLIC_KAKAO_JS_KEY=
